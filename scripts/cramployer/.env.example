# %% Host checkouts (absolute paths; no ~ expansion in Compose)
CRAM_SOURCE=${CRAM_REPOSITORY}
ROS_SOURCE=${HOME}/cramployer-workspace/ros_ws/src
REPOSITORY_URL=https://github.com/cram2/cognitive_robot_abstract_machine.git
REPOSITORY_BRANCH=main

# %% ROS communication
ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# %% Hardware and installation
ENABLE_NVIDIA=false
ENABLE_GUI=false
# default: omit CI's CPU-only index; cpu: keep CI commands unchanged.
TORCH_MODE=default
CONTAINER_MEMORY=16g
CONTAINER_CPUS=4
BUILD_PARALLEL_WORKERS=2

# %% Optional installation features
# Additional package-specific CI steps: robokudo,semantic_digital_twin
CI_PACKAGES=robokudo
# Comma-separated package:extra selections, e.g. semantic_digital_twin:iris
WORKSPACE_EXTRAS=

# %% Persistent Docker volume names
VOLUME_PREFIX=cramployer
VOLUMES_EXTERNAL=false
