<!--
  Every way MJCF lets an element be oriented, all five encoding the same rotation:
  a quarter turn about the y axis. MuJoCo keeps whichever form was written rather than
  normalising them into `quat`, so a parser that only reads `quat` silently drops four
  of the five.

  The last body carries the rotation on its geom instead of on itself, because elements
  are oriented by the same mechanism and both paths have to resolve it.
-->
<mujoco model="orientation_forms">
  <compiler angle="degree" eulerseq="xyz"/>
  <worldbody>
    <body name="euler_body"      pos="1 0 0" euler="0 90 0"/>
    <body name="quaternion_body" pos="2 0 0" quat="0.70710678 0 0.70710678 0"/>
    <body name="axis_angle_body" pos="3 0 0" axisangle="0 1 0 90"/>
    <body name="xy_axes_body"    pos="4 0 0" xyaxes="0 0 -1 0 1 0"/>
    <body name="z_axis_body"     pos="5 0 0" zaxis="1 0 0"/>
    <body name="geom_orientation_body" pos="6 0 0">
      <geom name="rotated_geom" type="box" size="0.3 0.2 0.1" euler="0 90 0"/>
    </body>
  </worldbody>
</mujoco>
