# Generated by `{{ generate_command }}` from {{ form.__qualname__ }} in {{ form.source_path }}. Never edit this file; change the form in the module named here, then regenerate.
name: {{ form.title | tojson }}
description: {{ form.description | tojson }}
{% if form.issue_type %}
type: {{ form.issue_type | tojson }}
{% endif %}
body:
{% for area in form.text_areas %}
  - type: textarea
    id: {{ area.identifier | tojson }}
    attributes:
      label: {{ area.label | tojson }}
{% if area.description %}
      description: {{ area.description | tojson }}
{% endif %}
{% if area.code_language %}
      render: {{ area.code_language | string | tojson }}
{% endif %}
    validations:
      required: {{ area.required | tojson }}
{% endfor %}
