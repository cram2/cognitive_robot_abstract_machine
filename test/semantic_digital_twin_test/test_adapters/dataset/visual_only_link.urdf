<?xml version="1.0"?>
<robot name="visual_only_link">
  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.3 0.3"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 0.2"/></geometry>
    </collision>
  </link>
  <link name="cover_link">
    <visual>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </visual>
  </link>
  <joint name="base_to_cover" type="fixed">
    <parent link="base_link"/>
    <child link="cover_link"/>
  </joint>
</robot>
