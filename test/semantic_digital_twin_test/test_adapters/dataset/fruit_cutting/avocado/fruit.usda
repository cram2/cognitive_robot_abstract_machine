#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "CulinaryCut"
    {
        def Mesh "RigidPit"
        {
            int[] faceVertexCounts = [3, 3, 3, 3]
            int[] faceVertexIndices = [0, 1, 2, 0, 1, 3, 0, 2, 3, 1, 2, 3]
            point3f[] points = [(0, 0, 0.01), (0.02, 0, 0.01), (0, 0.02, 0.01), (0, 0, 0.03)]
        }

        def Xform "Fruit"
        {
            def Mesh "Peel"
            {
                int[] faceVertexCounts = [3, 3, 3, 3]
                int[] faceVertexIndices = [0, 1, 2, 0, 1, 3, 0, 2, 3, 1, 2, 3]
                point3f[] points = [(0, 0, 0), (0.06, 0, 0), (0, 0.06, 0), (0, 0, 0.06)]
                int[] primvars:tissueId = [1, 1, 1, 1] (
                    interpolation = "uniform"
                )
            }

            def Mesh "Pulp"
            {
                int[] faceVertexCounts = [3, 3, 3, 3]
                int[] faceVertexIndices = [0, 1, 2, 0, 1, 3, 0, 2, 3, 1, 2, 3]
                point3f[] points = [(0, 0, 0), (0.05, 0, 0), (0, 0.05, 0), (0, 0, 0.05)]
                int[] primvars:tissueId = [2, 2, 2, 2] (
                    interpolation = "uniform"
                )
            }
        }
    }
}
