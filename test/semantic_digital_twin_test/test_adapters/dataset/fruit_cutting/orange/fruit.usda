#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "CulinaryCut"
    {
        def Xform "Fruit"
        {
            def Mesh "Peel"
            {
                int[] faceVertexCounts = [3, 3, 3, 3]
                int[] faceVertexIndices = [0, 1, 2, 0, 1, 3, 0, 2, 3, 1, 2, 3]
                point3f[] points = [(0, 0, 0), (0.08, 0, 0), (0, 0.08, 0), (0, 0, 0.08)]
                int[] primvars:tissueId = [1, 1, 1, 1] (
                    interpolation = "uniform"
                )
            }

            def Xform "Pulp"
            {
                def Mesh "Segment_01"
                {
                    int[] faceVertexCounts = [3, 3, 3, 3]
                    int[] faceVertexIndices = [0, 1, 2, 0, 1, 3, 0, 2, 3, 1, 2, 3]
                    point3f[] points = [(0, 0, 0), (0.03, 0, 0), (0, 0.03, 0), (0, 0, 0.03)]
                    int[] primvars:tissueId = [2, 3, 3, 3] (
                        interpolation = "uniform"
                    )
                }

                def Mesh "Segment_02"
                {
                    int[] faceVertexCounts = [3, 3, 3, 3]
                    int[] faceVertexIndices = [0, 1, 2, 0, 1, 3, 0, 2, 3, 1, 2, 3]
                    point3f[] points = [(0, 0, 0), (-0.03, 0, 0), (0, -0.03, 0), (0, 0, 0.03)]
                    int[] primvars:tissueId = [2, 3, 3, 3] (
                        interpolation = "uniform"
                    )
                }
            }
        }
    }
}
